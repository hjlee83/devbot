# GitHub personal access token with read access to the managed repositories.
# Required: DevBot fails to start without this set.
GITHUB_TOKEN=

# Local runtime root that contains every managed repository checkout.
# Optional (Issue #122) - only needed if you use the legacy
# config/repositories.yaml source. A deployment that manages only
# `devbot init`-registered repositories (run `devbot init` from inside each
# target repository) never needs to set this.
WORKSPACE_ROOT=/Users/luna/workspace

# Where `devbot init` records registered repositories' absolute paths.
# Optional - defaults to ~/.devbot/registry.yaml.
# DEVBOT_REGISTRY_PATH=

# Optional overrides (defaults shown).
POLL_INTERVAL_SECONDS=60
DEVBOT_LOCK_FILE=/tmp/devbot.lock
DEFAULT_AGENT=codex
MAX_CONCURRENT_JOBS=1
DRY_RUN=true
AUTOMERGE_ENABLED=false

# Log level: DEBUG, INFO, WARNING, or ERROR (case-insensitive). --verbose
# overrides this to DEBUG for a single run without changing this value.
LOG_LEVEL=INFO

# Keep uv's cache inside the repository when running in sandboxed agent
# environments that cannot access ~/.cache/uv.
UV_CACHE_DIR=.uv-cache
